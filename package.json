{
  "name": "jura-mcp",
  "version": "0.1.0",
  "description": "MCP server for Danish and EU legal sources",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "stdio": "tsx src/stdio.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/stdio.ts",
    "validate": "prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "test": "node --import=tsx --test --test-global-setup=./test/globalSetup.mjs test/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andreas-Westh/jura-mcp.git"
  },
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Andreas-Westh/jura-mcp/issues"
  },
  "homepage": "https://github.com/Andreas-Westh/jura-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "fast-xml-parser": "^5.11.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.2.0",
    "nock": "^14.0.17",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "private": true
}
